{
  "name": "reactjs-tryngo-programming-learning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/build-search-index.mjs && node scripts/build-quiz.mjs && node scripts/build-sitemap.mjs && node scripts/split-go-wasm.mjs && vite build",
    "postbuild": "node scripts/prerender-seo.mjs && node -e \"import fs from 'fs'; const p='dist/wasm/go-exec.wasm'; if(fs.existsSync(p)) fs.unlinkSync(p);\"",
    "deploy": "npm run build && wrangler pages deploy dist --project-name tryngo-web --commit-dirty=true",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "tsx scripts/audit_everything.mjs"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@stackblitz/sdk": "^1.11.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "fuse.js": "^7.5.0",
    "graphql": "^16.14.2",
    "lucide-react": "^0.546.0",
    "monaco-editor": "^0.56.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.64.0"
  }
}
